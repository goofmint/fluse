# Dart / Flutter のツール成果物
.dart_tool/
.packages
build/
doc/api/

# pub workspaces ではロックファイルはルートに1つだけ生成され、
# 全メンバーの解決結果を保持する。環境間で解決を再現するためコミットする。
# メンバー配下に紛れ込んだ pubspec.lock は pub が削除するので無視でよい。
packages/*/pubspec.lock

# Melos 6 以前が生成する残骸（移行時の取りこぼし対策）
pubspec_overrides.yaml

# fluse がユーザープロジェクト側に作る作業ディレクトリ。
# keystore / secret を含むため絶対にコミットしない（設計 §9.2）。
.flutter_preview/

# gh CLI がカレントディレクトリに作ることがあるローカル設定。
# hosts.yml はアクセストークンを持ちうるため絶対にコミットしない。
.gh/

# Android のビルド生成物とローカル設定。
# local.properties は SDK の絶対パスを持つため環境依存。
**/android/.gradle/
**/android/local.properties
**/android/.cxx/

# 署名鍵。混ざると取り返しがつかない（設計 §6.2）。
*.jks
*.keystore
*.p12
*.pem

# エディタ / OS
.idea/
*.iml
.vscode/
.DS_Store

# カバレッジ計測の出力
coverage/
